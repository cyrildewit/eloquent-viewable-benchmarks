root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,mjs,ts,astro,json,css,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

# Generated by scripts/import.ts and phpbench, never edited by hand.
[{runs,results}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
