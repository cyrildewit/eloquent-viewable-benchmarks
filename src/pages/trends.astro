---
import Base from '../layouts/Base.astro';
import SeriesFilters from '../components/SeriesFilters.astro';
import { loadIndex } from '../lib/results.ts';

const index = await loadIndex();
---

<Base title="Trends" current="trends" wide>
  <h1 class="text-2xl font-semibold tracking-tight">Trends</h1>
  <p class="mt-2 max-w-3xl text-ink-2">
    Every measurement across the releases, one chart per benchmark and parameter set, one line per database. Lower is
    faster. Hover a point for the exact time and its deviation; each chart also has a table.
  </p>

  {index.runs.length === 0 ? (
    <div class="card mt-6 p-6">
      <p class="font-medium">No runs yet.</p>
    </div>
  ) : (
    <>
      <SeriesFilters index={index} group />

      <p id="trend-status" class="mt-4 text-sm text-ink-2" aria-live="polite">
        Loading…
      </p>
      <div id="trends" class="mt-2" data-base={import.meta.env.BASE_URL} />
      <noscript>
        <p class="mt-4">The charts need JavaScript. Every number is also on the run pages, linked from the overview.</p>
      </noscript>
    </>
  )}

  <script>
    import { setupTrends } from '../scripts/trends.ts';

    setupTrends();
  </script>
</Base>
